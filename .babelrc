{
  "env": {
    "testing": {
      "presets": [
        ["@babel/preset-env", { "loose": true, "modules": "commonjs" }],
        "@babel/preset-react"
      ],
      "plugins": [
        ["@babel/plugin-proposal-class-properties", { "loose": true }],
        ["@babel/plugin-proposal-private-property-in-object", { "loose": true }],
        "@babel/plugin-proposal-export-default-from",
        ["@babel/plugin-transform-runtime", { "regenerator": true }],
        "react-docgen"
      ]
    },
    "development": {
      "presets": [["@babel/preset-env", { "loose": true }], "@babel/preset-react"],
      "plugins": [
        ["@babel/plugin-proposal-class-properties", { "loose": true }],
        ["@babel/plugin-proposal-private-property-in-object", { "loose": true }],
        "@babel/plugin-proposal-export-default-from",
        ["@babel/plugin-transform-runtime", { "regenerator": true }],
        "react-docgen"
      ]
    },
    "storybook": {
      "presets": [["@babel/preset-env", { "loose": true }], "@babel/preset-react"],
      "plugins": [
        ["@babel/plugin-proposal-class-properties", { "loose": true }],
        ["@babel/plugin-proposal-private-property-in-object", { "loose": true }],
        "@babel/plugin-proposal-export-default-from",
        "react-docgen"
      ]
    },
    "production": {
      "presets": [["@babel/preset-env", { "loose": true }], "@babel/preset-react"],
      "plugins": [
        ["@babel/plugin-proposal-class-properties", { "loose": true }],
        ["@babel/plugin-proposal-private-property-in-object", { "loose": true }],
        "@babel/plugin-proposal-export-default-from",
        ["css-modules-transform", {
          "preprocessCss": "./internals/css-modules-transform.js",
          "generateScopedName": "grm-[name]__[local]",
          "extensions": [".styl"],
          "extractCss": "./lib/css/modules/components.css"
        }],
        ["@babel/plugin-transform-runtime", { "regenerator": true }],
      ],
      "ignore": ["./internals/css-modules-transform.js"]
    }
  }
}
