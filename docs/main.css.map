/* ==========================================================================
   Variables
========================================================================== */


/* ==========================================================================
   Placeholders
========================================================================== */
$headerItem {
  font-size: 14px;
}

$spacing = 20px;

/* ==========================================================================
   Header Elements
========================================================================== */
$header {
  align-items: center;
  display: flex;
  height: 74px;
  justify-content: flex-end;
  padding: 0 $spacing;
  position: relative;
  width: 100%;
}

.content.showLogo {
  position: absolute;
  right: $spacing;
}

.logo {
  display: block;
  margin: 0 auto;
}
/* ==========================================================================
   Header Props
========================================================================== */
.primary {
  @extend $header;
  background: var(--c-primary);
  color: $white;
}

.secondary {
  @extend $header;
  background: var(--c-secondary);
  color: $white;
}

.support {
  @extend $header;
  background-color: var(--c-support-dark);
  color: $white;
}

