/* ==========================================================================
   Variables
========================================================================== */

$c-background-bar = #DCDCDC;

/* ==========================================================================
   ProgressBar Elements
========================================================================== */

.progressWrap {
  width: 100%;
  height: 4px;
  background-color: $c-background-bar;
}

.progressBar {
  display: block;
  height: 4px;
  transition: width 0.8s ease-in-out;
}

/* ==========================================================================
   ProgressBar Props
========================================================================== */

.primary {
  background-color: var(--c-primary);
}

.support {
  background-color: var(--c-support);
}

.error {
  background-color: var(--c-status-danger);
}

.warning {
  background-color: var(--c-status-alert);
}

.success {
  background-color: var(--c-feedback-success);
}
