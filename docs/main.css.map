/* ==========================================================================
   Variables
========================================================================== */
.default {
  align-items: center;
  border-radius: 10px;
  box-shadow: 0 3px 5px -1px rgba(0, 0, 0, 0.2);
  display: flex;
  min-height: 72px;
  max-height: 150px;
}

.success {
  background-color: var(--c-feedback-success);
}

.fail {
  background-color: var(--c-feedback-error);
}

.message {
  color: #FFFFFF;
  font-size: 14px;
  letter-spacing: 0.4px;
  line-height: 16px;
  width: 100%;
  padding: 16px 0;
  margin-left: 15px;
}

.icon {
  background-color: #fff;
  border-radius: 50%;
  color: var(--c-feedback-success);
  margin-left: 15px;
}

.iconClear {
  background-color: var(--c-feedback-success);
  border-radius: 50%;
  color: #fff;
  display: flex;
  flex-grow: 1;
  justify-content: flex-end;
  margin-right: 15px;
}

/* type error */
.iconError {
  border-radius: 50%;
  color: white;
  margin-left: 15px;
}

.iconCleanError {
  border-radius: 50%;
  color: white;
  display: flex;
  flex-grow: 1;
  justify-content: flex-end;
  margin-right: 15px;
}

.buttonClick {
  background-color: transparent;
  flex-grow: 1;
  align-self: flex-start;

  padding: 0;
  margin-top: 12px;

  cursor: pointer;

  &:hover {
    background-color: transparent;
  }

  &:active {
    box-shadow: none;
  }
}

.positionBottom {
  bottom: 60px;
  display: flex;
  justify-content: center;
  left: 0;
  margin-bottom: 0;
  position: fixed;
  right: 0;
}

.positionTop {
  position: fixed;
  right: 40px;
  top: 190px;
}

@keyframes slideUpwards {
  0% { bottom: -35%; }
  100% { bottom: 10px; }
}

.mobilePosition {
  bottom: -35%;
  animation: slideUpwards 0.5s forwards;
  left: 50%;
  position: fixed;
  transform: translate(-50%, -50%);
  width: 317px;

  &.isAboutToClose {
    bottom: 10px;
    animation: slideUpwards, slideUpwards 0.5s reverse forwards;
  }
}

@keyframes slideForwards {
  0% { right: -35%; }
  100% { right: 40px; }
}

.defaultPosition {
  position: fixed;
  right: -35%;
  top: 200px;
  width: 30%;

  animation: slideForwards 0.5s forwards;

  &.isAboutToClose {
    right: 40px;
    animation: slideForwards, slideForwards 0.5s reverse forwards;
  }
}
