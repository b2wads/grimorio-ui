/* ==========================================================================
   Variables
========================================================================== */
$c-input = #333;
$placeholder = #999;
$c-grey-1 = #60605f;
$c-hover = #3B3B3A;
$c-label = #999;
$c-disabled = #c7c7c7;
$c-blue-1 = #00A0b2;


/* ==========================================================================
   Placeholders
========================================================================== */
$menu {
  @extend $drop-shadow;
  background: $white;
  left: 0;
  list-style: none;
  margin: 0;
  opacity: 0;
  padding: 8px 0;
  position: absolute;
  top: 0;
  transform: scaleY(0);
  user-select: none;
  width: 100%;
  z-index: -1;
}

$field {
  border: 0;
  border-bottom: 1px solid $c-grey-1;
  border-top-left-radius: 2px;
  border-top-right-radius: 2px;
  color: $c-grey-1;
  display: block;
  font-size: inherit;
  height: 35px;
  outline: 0;
  text-indent: 5px;
  user-select: none;
  width: 100%;

  &:hover {
  border-color: $c-hover;
  color: $c-hover;
  }
}

/* ==========================================================================
   Select Elements
========================================================================== */
/* ==========================================================================
   Select Props
========================================================================== */
/* Default
================ */
.selectWrap {
  position: relative;
}

.button {
  cursor: pointer;
  display: block;
  position: relative;
}

.arrow {
  color: $c-grey-1;
  position: absolute;
  right: 0;
  top: 8px;
  z-index: 1;
}

.input {
  @extend $field;
  font-size: inherit;
  line-height: 1;
  overflow: hidden;
  padding-right: 15px;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 10px 16px 0 16px;
  font-size: 14px;

  transition: all 0.25s ease;

  &.isPlaceholder {
    color: $placeholder;
  }

  &.isActive {
    border-color: var(--c-primary);
  }

  &.isDisabled {
    background: white!important;
    border-color: $c-disabled!important;
    color: $c-disabled!important;
    cursor: not-allowed!important;
  }
}


.label {
  color: var(--c-active-input);
  font-size: 12px;
  margin-left: 16px;
  padding: 0 4px;
  display: block;
  z-index: 2;
  background-color: white;
  position: relative;
  width: max-content;

  &.isDisabled {
    background: white!important;
    border-color: $c-disabled!important;
    color: $c-disabled!important;
    cursor: not-allowed!important;
  }
}

.menu {
  @extend $menu;

  &.isUnder {
    top: calc(100% + 5px);
  }

  &.isBottom {
    bottom: 0;
    top: inherit;
  }

  &.isScroll {
    overflow-y: scroll;
  }

  &.isOpen {
    opacity: 1;
    transform: scaleY(1);
    transition: opacity 0.5s ease;
    z-index: $z-upmax;
    margin-top: 50px;
  }

  &.isMobile {
    border-radius: 2px;
    left: 50%;
    max-height: calc(100vh - 140px);
    overflow-y: scroll;
    position: fixed;
    top: 70px;
    transform: translate(-50%, 0);
    width: 90%;
  }
}

.option {
  color: $c-grey-1;
  font-size: 14px;
  cursor: pointer;
  padding: 10px 16px;
  display: flex;
  justify-content: space-between;

  &:hover {
    background: $color-light-1;
  }

  &.isSelected {
    color: $c-blue-1;
  }

  .selectedIcon {
    align-items: right;
  }
}

.optionIcon {
  margin-right: 5px;
}

.optionContent {
  display: inline-block;
  vertical-align: middle;
  word-break: break-all;
}

.overlay {
  @extend $overlay;
}

.isOutline {
  .input {
    border: 1px solid $c-grey-1;
    color: $c-grey-1;
    border-radius: 2px;
    line-height: 5px;
    padding: 24px 14px 22px;

    &:hover {
      border-color: $c-hover;
    }
  }

  .arrow {
    right: 5px;
    top: 22px;
  }

  .label {
    margin-bottom: -9px;
  }

  .menu {
    top: 10px;
  }

  .isFocus:not(.isDisabled, .has-error, .has-warning) {
    border-color: $c-blue-1!important;
    outline: 1px solid $c-blue-1;
  }
}
