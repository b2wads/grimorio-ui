/* ==========================================================================
   Variables
========================================================================== */
$c-input = #333;
$placeholder = #999;
$c-border = #ccc;
$c-label = #999;
$c-disabled = #c7c7c7;
$c-blue-1 = #00A0b2;


/* ==========================================================================
   Placeholders
========================================================================== */
$menu {
  @extend $drop-shadow;
  background: $white;
  left: 0;
  list-style: none;
  margin: 0;
  opacity: 0;
  padding: 8px 0;
  position: absolute;
  top: 0;
  transform: scaleY(0);
  user-select: none;
  width: 100%;
  z-index: -1;
}

$field {
  border: 0;
  border-bottom: 1px solid $c-border;
  border-top-left-radius: 3px;
  border-top-right-radius: 3px;
  color: inherit;
  display: block;
  font-size: inherit;
  height: 35px;
  outline: 0;
  text-indent: 5px;
  user-select: none;
  width: 100%;
}

/* ==========================================================================
   Select Elements
========================================================================== */
/* ==========================================================================
   Select Props
========================================================================== */
/* Default
================ */
.selectWrap {
  position: relative;
}

.button {
  cursor: pointer;
  display: block;
  position: relative;
}

.arrow {
  color: $c-text;
  position: absolute;
  right: 0;
  top: 8px;
  z-index: 1;
}

.input {
  @extend $field;
  font-size: inherit;
  line-height: 1;
  overflow: hidden;
  padding-right: 15px;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 10px 16px 0 16px;
  font-size: 14px;

  &.isPlaceholder {
    color: $placeholder;
  }

  &.isActive {
    border-color: var(--c-primary);
  }

  &.isDisabled {
    background: white;
    border-color: $c-disabled;
    color: $c-disabled;
    cursor: not-allowed;
  }
}

