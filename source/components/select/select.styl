}

.menu {
  @extend $menu;

  &.isUnder {
    top: calc(100% + 5px);
  }

  &.isBottom {
    bottom: 0;
    top: inherit;
  }

  &.isScroll {
    overflow-y: scroll;
  }

  &.isOpen {
    opacity: 1;
    transform: scaleY(1);
    transition: opacity 0.5s ease;
    z-index: $z-upmax;
  }

  &.isMobile {
    border-radius: 2px;
    left: 50%;
    max-height: calc(100vh - 140px);
    overflow-y: scroll;
    position: fixed;
    top: 70px;
    transform: translate(-50%, 0);
    width: 90%;
  }
}

.option {
  color: $c-text;
  cursor: pointer;
  padding: 10px 16px;

  &:hover {
    background: $c-secondary-light;
  }

  &.isSelected {
    background: $c-secondary;
    border: 1px solid red;
    color: $c-blue-1;

  }
}

.optionIcon {
  margin-right: 5px;
}

.optionContent {
  display: inline-block;
  vertical-align: middle;
  word-break: break-all;
}

.overlay {
  @extend $overlay;
}

.isOutline {
  .input {
    border: 1px solid $c-border;
    border-radius: 3px;
    line-height: 5px;
    padding: 24px 14px 22px;
  }

  .arrow {
    right: 5px;
    top: 16px;
  }

  .label {
    // padding-left: 10px;
    margin-bottom: -8px;


    &.isActive {
      background: $white;
      // left: 10px;
      // padding: 0 5px;
      // top: -6px;
    }
  }

  .menu {
    top: 10px;
  }
}
